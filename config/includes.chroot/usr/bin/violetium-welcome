#!/bin/bash

export VIOLETIUM_INFO=/usr/bin/violetium-info

xterm \
    -title "Welcome to VioletiumOS!" \
    -geometry 36x24 \
    -fa "DejaVu Sans" \
    -fs 11 \
    -e bash -c '
        clear
        "$VIOLETIUM_INFO"
        printf "\n\033[1;37mWelcome to\033[0m\n"
        printf "\033[1;37mVioletiumOS!\033[0m\n\n"
        printf "Try VioletiumOS without\n"
        printf "installing it first.\n\n"
        printf "The live environment\n"
        printf "includes games and apps.\n"
        printf "Most will not be\n"
        printf "installed on your computer.\n\n"
        printf "Install VioletiumOS if\n"
        printf "you enjoy it!\n\n"
        printf "Press Enter to continue..."
        read -r
    '
