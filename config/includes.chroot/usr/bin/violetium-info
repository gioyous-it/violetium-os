#!/bin/sh

. /etc/os-release

printf '%s\n' "$PRETTY_NAME"
printf '%s\n' "ID:           $ID"
printf '%s\n' "Version:      $VERSION_ID"
printf '%s\n' "Architecture: $(dpkg --print-architecture)"
printf '%s\n' "Kernel:       $(uname -r)"
printf "%-14s%s\n" "Desktop:" "${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-Unknown}}"
printf "%-14s%s\n" "Display:" "${XDG_SESSION_TYPE:-Unknown}"
printf "%-14s%s\n" "Init:" "$(ps -p 1 -o comm=)"
