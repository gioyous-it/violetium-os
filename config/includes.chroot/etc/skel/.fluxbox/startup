#!/bin/sh

# Notifications
dunst &
# System tray applets
nm-applet &
blueman-applet &
cbatticon &

# Future wallpaper
# feh --bg-fill /usr/share/backgrounds/violetium.png &

# Future Wayland/Weston support — VioletiumOS 0.2.x
# weston --backend=x11-backend.so &

# Generate VioletiumOS user-customizable Utilities menu
if [ -x "$HOME/.local/bin/violetium-utilities" ]; then
    "$HOME/.local/bin/violetium-utilities"
fi

# Generate VioletiumOS Installed Apps menu
if [ -x "$HOME/.local/bin/violetium-installed-apps" ]; then
    "$HOME/.local/bin/violetium-installed-apps"
fi

# Generate VioletiumOS My Apps menu
if [ -x "$HOME/.local/bin/violetium-my-apps" ]; then
    "$HOME/.local/bin/violetium-my-apps"
fi

# Restore user-saved wallpaper (overrides the default Blossom wallpaper)
if [ -x "$HOME/.fehbg" ]; then
    "$HOME/.fehbg"
fi

# Live-environment-only desktop icon
if [ -d /run/live/medium ] || [ -d /lib/live/mount/medium ]; then
    mkdir -p "$HOME/Desktop"

    cat > "$HOME/Desktop/VioletiumOS Webpage.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=VioletiumOS Webpage
Comment=Open the VioletiumOS website
Exec=open https://violetium.gioyous.it
Icon=internet-web-browser
Terminal=false
Categories=Network;
DESKTOP

    chmod +x "$HOME/Desktop/VioletiumOS Webpage.desktop"
fi

# VioletiumOS desktop icons
pcmanfm --desktop &

# Live-environment-only welcome window
if [ -d /run/live/medium ] || [ -d /lib/live/mount/medium ]; then
    violetium-welcome &
fi

exec fluxbox
